---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";

const links = [
  { href: "/blog", label: "Blog" },
  {
    href: "/you_may_not_need_a_lambda_malta.pdf",
    label: "AWS Community Day Malta - Slides",
  },
  { href: "https://github.com/tomassabol", label: "GitHub" },
  { href: "https://www.linkedin.com/in/tomas-sabol/", label: "LinkedIn" },
  { href: "https://bsky.app/profile/tomassabol.com", label: "Bluesky" },
  { href: "https://twitter.com/tomassabol1337", label: "Twitter" },
  { href: "https://www.behance.net/tomassabol", label: "Behance" },
  { href: "https://www.instagram.com/_tomassabol/", label: "Instagram" },
  {
    href: "https://www.youtube.com/watch?v=dQw4w9WgXcQ&pp=ygULcmljayBhc3RsZXk%3D",
    label: "YouTube",
  },
];
---

<Layout title="Tomáš Sabol's Portfolio">
  <main
    class="antialiased font-sans min-h-[100svh] flex flex-col bg-white dark:bg-[#0A0A0A]"
  >
    <section
      id="landing"
      class="flex flex-1 flex-col justify-center px-6 py-16 md:px-16 md:py-24"
    >
      <div class="mx-auto w-full max-w-xl">
        <div class="flex flex-col gap-10">
          <header class="flex flex-col gap-3">
            <h1
              class="text-3xl font-medium tracking-tight text-black dark:text-white sf-rounded"
            >
              Tomas Sabol
            </h1>
            <p class="text-xl font-medium text-black dark:text-white">
              AWS Solutions Architect
            </p>
            <p
              class="text-base leading-relaxed text-black/64 dark:text-white/56"
            >
              AWS, Node.js, TypeScript, Next.js, React Native
            </p>
          </header>

          <div class="flex flex-col gap-8">
            <div>
              <Button href="https://cal.com/tomassabol" variant="primary">
                Book a meeting
              </Button>
            </div>

            <nav aria-label="Links">
              <ul class="flex flex-col gap-3">
                {
                  links.map((link) => (
                    <li>
                      <Button href={link.href}>{link.label}</Button>
                    </li>
                  ))
                }
              </ul>
            </nav>
          </div>
        </div>
      </div>
    </section>

    <footer
      class="flex flex-col items-center gap-2 px-6 py-8 text-center text-sm text-black/56 dark:text-white/46"
    >
      <p>
        Made with love and
        <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer"
          class="underline decoration-black/20 underline-offset-2 hover:text-black dark:decoration-white/20 dark:hover:text-white"
        >
          Astro
        </a>
      </p>
      <a
        href="https://vercel.com"
        target="_blank"
        rel="noopener noreferrer"
        class="text-black dark:text-white"
        aria-label="Hosted on Vercel"
      >
        <svg
          aria-hidden="true"
          fill="currentColor"
          height="18"
          viewBox="0 0 283 64"
        >
          <path
            d="M141.68 16.25c-11.04 0-19 7.2-19 18s8.96 18 20 18c6.67 0 12.55-2.64 16.19-7.09l-7.65-4.42c-2.02 2.21-5.09 3.5-8.54 3.5-4.79 0-8.86-2.5-10.37-6.5h28.02c.22-1.12.35-2.28.35-3.5 0-10.79-7.96-17.99-19-17.99zm-9.46 14.5c1.25-3.99 4.67-6.5 9.45-6.5 4.79 0 8.21 2.51 9.45 6.5h-18.9zm117.14-14.5c-11.04 0-19 7.2-19 18s8.96 18 20 18c6.67 0 12.55-2.64 16.19-7.09l-7.65-4.42c-2.02 2.21-5.09 3.5-8.54 3.5-4.79 0-8.86-2.5-10.37-6.5h28.02c.22-1.12.35-2.28.35-3.5 0-10.79-7.96-17.99-19-17.99zm-9.45 14.5c1.25-3.99 4.67-6.5 9.45-6.5 4.79 0 8.21 2.51 9.45 6.5h-18.9zm-39.03 3.5c0 6 3.92 10 10 10 4.12 0 7.21-1.87 8.8-4.92l7.68 4.43c-3.18 5.3-9.14 8.49-16.48 8.49-11.05 0-19-7.2-19-18s7.96-18 19-18c7.34 0 13.29 3.19 16.48 8.49l-7.68 4.43c-1.59-3.05-4.68-4.92-8.8-4.92-6.07 0-10 4-10 10zm82.48-29v46h-9v-46h9zM37.59.25l36.95 64H.64l36.95-64zm92.38 5l-27.71 48-27.71-48h10.39l17.32 30 17.32-30h10.39zm58.91 12v9.69c-1-.29-2.06-.49-3.2-.49-5.81 0-10 4-10 10v14.8h-9v-34h9v9.2c0-5.08 5.91-9.2 13.2-9.2z"
          ></path>
        </svg>
      </a>
    </footer>
  </main>
</Layout>
